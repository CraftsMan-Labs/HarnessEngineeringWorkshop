# 9Router dashboard login password on first boot; change it after logging in.
NINEROUTER_INITIAL_PASSWORD=123456

# API key dsh sends to 9Router. Create one from the 9Router dashboard
# (http://localhost:20128/dashboard) after the stack is up, then set this
# and restart the dsh service.
NINEROUTER_API_KEY=

# 9Router's OpenAI-compatible endpoint that dsh routes model calls through.
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

# Model id to route through, as listed in the 9Router dashboard.
NINEROUTER_MODEL=cc/claude-opus-4-6
