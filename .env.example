# 9Router dashboard login password on first boot; change it after logging in.
NINEROUTER_INITIAL_PASSWORD=123456

# API key dsh sends to 9Router. Create one from the 9Router dashboard
# (http://localhost:20128/dashboard) after the stack is up, then set this
# and restart the dsh service.
NINEROUTER_API_KEY=

# 9Router's OpenAI-compatible endpoint that dsh routes model calls through.
# Docker's internal DNS resolves the service name; only override this if you
# point dsh at a 9Router running outside this compose stack.
NINEROUTER_BASE_URL=http://ninerouter:20128/v1

# Model id to route through, as listed in the 9Router dashboard.
NINEROUTER_MODEL=cc/claude-opus-4-6

# dsh 0.1.5+ requires ?token= on first open. This workshop is loopback-only,
# so auth is off by default. Set 1 to restore the printed-URL token gate.
DSH_WEB_AUTH=0

# Software-factory plugin (Host+Client). Set to 0 to skip install and mount.
FACTORY_PLUGIN_ENABLED=1
FACTORY_STATE_PATH=/workspace/.factory
FACTORY_MUTATION_TOOLS=write,edit,bash,shell,apply_patch,str_replace,write_file,edit_file,run_terminal_cmd
FACTORY_GATE_COMMANDS=npm test
FACTORY_API_PORT=13081
